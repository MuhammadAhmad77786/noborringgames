{
  "name": "craft-site",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "web",
    "admin"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:admin": "npm run dev -w admin",
    "build:web": "npm run build -w web",
    "build:admin": "npm run build -w admin",
    "seed": "npm run seed -w @craft/seed",
    "typecheck": "npm run typecheck -w @craft/db -w @craft/shared -w @craft/seed -w web -w admin",
    "lint": "npm run lint -w web -w admin"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
