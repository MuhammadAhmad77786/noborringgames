# Public site (web/) — copy to .env.local. Never commit real values.
MONGODB_URI=
# Optional, local only: set to 8.8.8.8,1.1.1.1 if you get "queryTxt ETIMEOUT"
MONGODB_DNS_SERVERS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SITE_URL=https://{{DOMAIN}}
ADMIN_URL=https://admin.{{DOMAIN}}
# Shared with admin/: admin calls POST {SITE_URL}/api/revalidate with this secret.
REVALIDATE_SECRET=
# Optional: signs email-gated download links (falls back to REVALIDATE_SECRET).
DOWNLOAD_SECRET=
