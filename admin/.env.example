# Admin panel (admin/) — copy to .env.local. Never commit real values.
MONGODB_URI=
# Optional, local only: set to 8.8.8.8,1.1.1.1 if you get "queryTxt ETIMEOUT"
MONGODB_DNS_SERVERS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Signs admin session cookies. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Used only by the seed script to create the first admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SITE_URL=https://{{DOMAIN}}
ADMIN_URL=https://admin.{{DOMAIN}}
# Same value as in web/.env — authorises POST {SITE_URL}/api/revalidate
REVALIDATE_SECRET=
# Optional: protects /api/cron/publish (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
